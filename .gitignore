*.env
*cookies*
*.key
node_modules/
pm2_before.json
stress_test_result.json

# Agent 執行任務時產生的一次性暫存腳本（僅限 repo 根目錄）
# 樣式一律加 / 前綴限定在根目錄，避免誤擋 scripts/ 底下的正式腳本。
# 2026-08-29 曾因 check_*.py 為全域樣式，導致 scripts/check_consistency.py
# 被靜默忽略，必須用 git add -f 才進得去版控。
/batch*.py
/batch*.json
/fix_*.py
/check_*.py
/migrate_*.py
/update_*.py
/write_*.py
/*_temp.py
/*_tmp.py

# Python 快取（pytest 執行後產生）
__pycache__/
*.pyc
.pytest_cache/

# MCP 設定與憑證（ADR-0016、ADR-0019）
# mcp_config.json 含明文 JULES_API_KEY 等金鑰，禁止進入本 repo
mcp_config*.json
temp_mcp.json
.env.local
.env.*.local

# Agent 暫存輸出（實際發生過寫進 repo 根目錄的案例）
# 同樣以 / 前綴限定在根目錄，理由見上方說明。
/scratch_out.txt
/git_files.txt
/process*.py
/verify*.py
/gather*.py
*.tmp
/diff*.txt
